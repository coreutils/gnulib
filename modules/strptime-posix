Description:
Convert a string representation of time to a tm structure,
using a format string that specifles all 6 essential tm fields.

Files:
lib/strptime.c
m4/strptime.m4
m4/tm_gmtoff.m4

Depends-on:
time-h
extensions
sys_time-h      [test $HAVE_STRPTIME = 0 || test $REPLACE_STRPTIME = 1]
string-h        [test $HAVE_STRPTIME = 0 || test $REPLACE_STRPTIME = 1]
strncasecmp     [test $HAVE_STRPTIME = 0 || test $REPLACE_STRPTIME = 1]
bool            [test $HAVE_STRPTIME = 0 || test $REPLACE_STRPTIME = 1]
time_r          [test $HAVE_STRPTIME = 0 || test $REPLACE_STRPTIME = 1]

configure.ac:
gl_FUNC_STRPTIME_POSIX
gl_CONDITIONAL([GL_COND_OBJ_STRPTIME],
               [test $HAVE_STRPTIME = 0 || test $REPLACE_STRPTIME = 1])
AM_COND_IF([GL_COND_OBJ_STRPTIME], [
  gl_PREREQ_STRPTIME
])
gl_TIME_MODULE_INDICATOR([strptime-posix])

Makefile.am:
if GL_COND_OBJ_STRPTIME
lib_SOURCES += strptime.c
endif

Include:
<time.h>

License:
LGPLv2+

Maintainer:
glibc
