Description:
Sanitizing the TZ environment variable on native Windows.

Files:
lib/tzsanitize.h
lib/tzsanitize.c

Depends-on:

configure.ac:
AC_REQUIRE([AC_CANONICAL_HOST])
gl_CONDITIONAL([GL_COND_OBJ_TZSANITIZE],
               [case "$host_os" in mingw* | windows*) true;; *) false;; esac])

Makefile.am:
if GL_COND_OBJ_TZSANITIZE
lib_SOURCES += tzsanitize.c
endif

Include:
"tzsanitize.h"

